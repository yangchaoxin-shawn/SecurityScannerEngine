# ============================================================
# 全自动安全扫描引擎 — 环境变量配置模板
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env：  copy .env.example .env
#   2. 取消注释你需要修改的变量，然后修改等号右侧的值
#   3. 未注释的变量使用下方标注的「默认值」
#   4. .env 已配置 .gitignore，不会被提交到代码仓库
# ============================================================

# ──────────────────────────────────────────────────────────
#  靶场应用
# ──────────────────────────────────────────────────────────

# 靶场监听主机地址 [默认值: 127.0.0.1]
# SCANNER_TARGET_HOST=127.0.0.1

# 靶场监听端口 [默认值: 5000]
# SCANNER_TARGET_PORT=5000


# ──────────────────────────────────────────────────────────
#  MySQL 数据库（SQL 注入靶场依赖）
# ──────────────────────────────────────────────────────────

# MySQL 主机地址 [默认值: 127.0.0.1]
# DB_HOST=127.0.0.1

# MySQL 端口 [默认值: 3306]
# DB_PORT=3306

# MySQL 用户名 [默认值: root]
# DB_USER=root

# MySQL 密码 [默认值: changeme]    ← 通常需要取消注释并修改
# DB_PASSWORD=changeme

# 数据库名称 [默认值: vuln_db]
# DB_NAME=vuln_db

# 数据库字符集 [默认值: utf8mb4]
# DB_CHARSET=utf8mb4


# ──────────────────────────────────────────────────────────
#  报警服务器（TCP）
# ──────────────────────────────────────────────────────────

# 报警服务器主机地址 [默认值: 127.0.0.1]
# ALERT_SERVER_HOST=127.0.0.1

# 报警服务器端口 [默认值: 9999]
# ALERT_SERVER_PORT=9999


# ──────────────────────────────────────────────────────────
#  扫描器参数
# ──────────────────────────────────────────────────────────

# HTTP 请求超时时间（秒）[默认值: 5]
# SCANNER_TIMEOUT=5


# ──────────────────────────────────────────────────────────
#  日志
# ──────────────────────────────────────────────────────────

# 日志级别: DEBUG / INFO / WARNING / ERROR [默认值: INFO]
# LOG_LEVEL=INFO
